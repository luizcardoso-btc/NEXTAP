document.getElementById('tiers').innerHTML=TIERS.map(function(t,i){var l=t[1]===1e9?t[0]+' placas ou mais':t[0]===t[1]?'1 placa':t[0]+' a '+t[1]+' placas';return '<div class="'+(i==3?'best':'')+'"><span>'+l+(i==3?' <span class="tag">MELHOR PREÇO</span>':'')+'</span><b>'+R(t[2])+'</b></div>'}).join('');
document.getElementById('wal').href='https://wa.me/'+WHATS;
['lnkEntrar','lnkEntrar2'].forEach(function(id){document.getElementById(id).href=APP_URL+'?tab=login'});

<!DOCTYPE html>
<html lang="pt-BR"><head>
<meta name="robots" content="noindex,nofollow"><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>NexTap — Painel do Revendedor</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f0f5f1;--card:#fff;--tx:#0f1a13;--mut:#5b6b60;--br:#dfe8e2;--pr:#15803d;--pr2:#0f6a31;--soft:#e4f0e8}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1410;--card:#16211b;--tx:#eaf3ed;--mut:#9bb0a3;--br:#243329;--soft:#1b2a21}}
:root[data-theme="dark"]{--bg:#0d1410;--card:#16211b;--tx:#eaf3ed;--mut:#9bb0a3;--br:#243329;--soft:#1b2a21}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;line-height:1.45}
.logo{font-weight:800;font-size:21px;display:flex;align-items:center;gap:8px}.logo i{width:30px;height:30px;border-radius:8px;background:var(--pr);display:grid;place-items:center;color:#fff;font-style:normal}
.btn{display:inline-block;border:1px solid var(--br);background:var(--card);color:var(--tx);padding:9px 16px;border-radius:10px;font:600 14px inherit;cursor:pointer}.btn.p{background:var(--pr);border-color:var(--pr);color:#fff}.btn.p:hover{background:var(--pr2)}.btn.s{padding:5px 10px;font-size:12px}
input,select{padding:10px;border:1px solid var(--br);border-radius:10px;background:var(--card);color:var(--tx);font:inherit;width:100%;min-width:0}
label{display:grid;gap:4px;font-size:12px;color:var(--mut)}.mut{color:var(--mut)}
#auth{min-height:100vh;display:grid;place-items:center;padding:20px}#auth .box{width:100%;max-width:400px;background:var(--card);border:1px solid var(--br);border-radius:18px;padding:28px;display:grid;gap:12px}
.tabs{display:flex;background:var(--bg);border-radius:10px;padding:4px}.tabs button{flex:1;border:0;background:none;padding:8px;border-radius:8px;font:600 14px inherit;color:var(--mut);cursor:pointer}.tabs button.on{background:var(--card);color:var(--pr)}
#app{display:none;grid-template-columns:240px 1fr;min-height:100vh}
aside{background:var(--card);border-right:1px solid var(--br);padding:18px;display:flex;flex-direction:column;gap:2px;position:sticky;top:0;height:100vh}
aside small{color:var(--mut);font-size:11px;letter-spacing:.06em;margin:14px 10px 4px}aside a{padding:10px 12px;border-radius:10px;font-size:14px;cursor:pointer;color:var(--tx)}aside a.on{background:var(--soft);color:var(--pr);font-weight:700}
.me{margin-top:auto;display:flex;gap:10px;align-items:center;padding:10px;border:1px solid var(--br);border-radius:12px;font-size:13px}.av{width:34px;height:34px;border-radius:50%;background:var(--pr);color:#fff;display:grid;place-items:center;font-weight:700}
main{padding:24px;min-width:0}.top{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:8px;flex-wrap:wrap}h2{margin:0}
.card{background:var(--card);border:1px solid var(--br);border-radius:14px;padding:18px;margin-top:14px}.card h3{margin:0 0 10px;font-size:16px}
.k{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-top:14px}.k div{background:var(--card);border:1px solid var(--br);border-radius:14px;padding:16px}.k small{color:var(--mut)}.k b{display:block;font-size:22px;margin-top:4px}.k div:first-child{background:var(--pr);color:#fff;border-color:var(--pr)}.k div:first-child small{color:#d4f5df}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.pill{padding:7px 13px;border-radius:99px;border:1px solid var(--br);background:var(--card);color:var(--tx);cursor:pointer;font-size:13px}.pill.on{background:var(--pr);color:#fff;border-color:var(--pr)}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--br);white-space:nowrap}th{color:var(--mut);font-weight:600}
.st{padding:3px 10px;border-radius:99px;font-size:12px;font-weight:700;background:var(--soft);color:var(--pr)}.st.w{background:#fef3c7;color:#92400e}.st.g{background:#e5e7eb;color:#374151}
.bars{display:flex;align-items:flex-end;gap:10px;height:150px}.bars div{flex:1;text-align:center;font-size:11px;color:var(--mut);display:flex;flex-direction:column;justify-content:flex-end;height:100%}.bars i{background:var(--pr);border-radius:6px 6px 0 0;display:block;min-height:2px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px;margin-top:14px}
.pl{background:var(--card);border:1px solid var(--br);border-radius:14px;padding:14px;display:grid;gap:6px;font-size:13px}.sw{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px}
.qty{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--br)}.qty button{width:30px;height:30px;border-radius:8px;border:1px solid var(--br);background:var(--card);color:var(--tx);font-size:17px;cursor:pointer}
.tier{display:flex;justify-content:space-between;padding:9px 12px;border:1px solid var(--br);border-radius:10px;margin-bottom:6px;font-size:14px}.tier.on{border-color:var(--pr);background:var(--soft);font-weight:700}
.pg{height:8px;background:var(--bg);border-radius:9px;overflow:hidden}.pg i{display:block;height:100%;background:var(--pr)}
#mo{display:none;position:fixed;inset:0;background:#0007;z-index:20;place-items:center;padding:16px}#mo .box{background:var(--card);border-radius:16px;padding:22px;width:100%;max-width:420px;display:grid;gap:10px;max-height:90vh;overflow:auto}
@media(max-width:800px){#app{grid-template-columns:1fr}aside{position:static;height:auto;flex-direction:row;overflow-x:auto;align-items:center}aside small,.me{display:none}aside a{white-space:nowrap}.g2{grid-template-columns:1fr}}
</style></head><body>

<div id="auth"><div class="box">
<div class="logo" style="justify-content:center"><img src="data:image/png;base64," alt="NexTap" style="height:44px;width:auto"></div>
<div class="tabs"><button id="ta" class="on" onclick="at('c')">Criar conta grátis</button><button id="tb" onclick="at('e')">Entrar</button></div>
<label id="ln">Nome<input id="an" autocomplete="name"></label>
<label>E-mail<input id="ae" type="email" autocomplete="email"></label>
<label id="lw">WhatsApp<input id="aw" placeholder="(75) 9…"></label>
<label>Senha<input id="ap" type="password" autocomplete="current-password"></label>
<button class="btn p" id="ab" onclick="sub()">Criar conta grátis</button>
<small class="mut">Cadastro gratuito. Você só paga quando fizer um pedido.</small></div></div>

<div id="app">
<aside><div class="logo" style="padding:4px 8px 8px"><i>✓</i>NexTap</div>
<small>PAINEL</small><a data-v="dash" onclick="nav('dash')">▦ Dashboard</a><a data-v="placas" onclick="nav('placas')">▣ Minhas placas</a><a data-v="vendas" onclick="nav('vendas')">↗ Vendas</a>
<small>ESTOQUE</small><a data-v="comprar" onclick="nav('comprar')">🛒 Comprar placas</a><a data-v="pedidos" onclick="nav('pedidos')">📦 Meus pedidos</a><a data-v="conta" onclick="nav('conta')">👤 Minha conta</a><a onclick="window.open('https://wa.me/'+WHATS,'_blank')">💬 Suporte</a>
<small>TREINAMENTO</small><a data-v="academy" onclick="nav('academy')">🎓 NFC Academy</a>
<div class="me"><div class="av" id="av"></div><div style="min-width:0"><b id="un"></b><div class="mut">Revendedor</div></div><button class="btn s" style="margin-left:auto" onclick="out()" title="Sair">⎋</button></div></aside>
<main><div class="top"><div id="hd"></div><span class="row" style="margin:0"><button class="btn" onclick="theme()">◐</button><button class="btn p" onclick="nav('comprar')">Comprar placas</button></span></div><div id="v"></div></main></div>
<div id="mo"><div class="box" id="mb"></div></div>

<script>
/* ==== CONFIGURAÇÃO ==== */
// Troque pela URL pública do seu backend depois do deploy (Railway/Render), terminando em /api
// Mesmo domínio do backend: as páginas são servidas pelo próprio Railway, então a API fica em /api
// (sem CORS). Se abrir o arquivo direto do computador, cai no endereço público do backend.
const API_BASE = (location.protocol.indexOf("http") === 0 ? location.origin : "https://nextap-production-6c30.up.railway.app") + "/api";
const PUBLIC_BASE = API_BASE.replace(/\/api\/?$/, "");
var WHATS = "5575988209055";
/* ======================= */

var $=function(i){return document.getElementById(i)};
var TOKEN=null, ME=null, TIERS=[], PLATES=[], SALES=[], ORDERS=[];
var per='all',cur='dash',mode='c',N={azul:10,preta:10},selPl=0,pollTimer=null;
var LES=['Como ativar uma placa (NFC + QR Code dinâmico)','Como proteger sua tag NFC com senha','Como configurar o NFC','Como usar a plataforma','Como apresentar a placa ao cliente'];

function R(n){return (n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}
function E(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function fd(d){return new Date(d).toLocaleDateString('pt-BR')}
function pad(i){return String(i).padStart(4,'0')}
function theme(){var r=document.documentElement,d=r.dataset.theme==='dark'||(!r.dataset.theme&&matchMedia('(prefers-color-scheme:dark)').matches);r.dataset.theme=d?'light':'dark'}
function lsLes(){try{return JSON.parse(localStorage.getItem('nx_les_'+(ME?ME.email:'x'))||'{}')}catch(e){return {}}}
function svLes(o){try{localStorage.setItem('nx_les_'+(ME?ME.email:'x'),JSON.stringify(o))}catch(e){}}

/* ---- chamada de API ---- */
async function api(path,opts){
  opts=opts||{};var h=opts.headers||{};h['Content-Type']='application/json';if(TOKEN)h['Authorization']='Bearer '+TOKEN;
  var r;try{r=await fetch(API_BASE+path,Object.assign({},opts,{headers:h}))}
  catch(e){throw new Error('Não foi possível conectar ao servidor. Verifique sua internet ou tente novamente em instantes.')}
  var data=null;try{data=await r.json()}catch(e){}
  if(!r.ok)throw new Error((data&&data.error)||'Ocorreu um erro inesperado.');
  return data;
}

/* ---- autenticação ---- */
function at(m){mode=m;$('ta').className=m==='c'?'on':'';$('tb').className=m==='e'?'on':'';$('ln').style.display=$('lw').style.display=m==='c'?'':'none';$('ab').textContent=m==='c'?'Criar conta grátis':'Entrar'}
async function sub(){
  var email=$('ae').value.trim(),pass=$('ap').value;
  if(!email||pass.length<6)return alert('Informe e-mail e senha (mínimo 6 caracteres).');
  $('ab').disabled=true;
  try{
    var r;
    if(mode==='c'){
      var name=$('an').value.trim();if(!name)throw new Error('Informe seu nome.');
      r=await api('/auth/register',{method:'POST',body:JSON.stringify({name:name,email:email,whatsapp:$('aw').value.trim(),password:pass})});
    }else{
      r=await api('/auth/login',{method:'POST',body:JSON.stringify({email:email,password:pass})});
    }
    TOKEN=r.token;try{localStorage.setItem('nx_token',TOKEN)}catch(e){}
    await boot();
  }catch(e){alert(e.message)}finally{$('ab').disabled=false}
}
async function boot(){
  ME=await api('/resellers/me');
  await Promise.all([loadTiers(),loadPlates(),loadSales(),loadOrders()]);
  $('auth').style.display='none';$('app').style.display='grid';
  $('un').textContent=ME.name;$('av').textContent=ME.name.charAt(0).toUpperCase();
  nav('dash');
}
function out(){TOKEN=null;ME=null;try{localStorage.removeItem('nx_token')}catch(e){}$('app').style.display='none';$('auth').style.display='grid'}
async function loadTiers(){TIERS=await api('/resellers/price-tiers')}
async function loadPlates(){PLATES=await api('/resellers/plates')}
async function loadSales(){SALES=await api('/resellers/sales')}
async function loadOrders(){ORDERS=await api('/resellers/orders')}
function price(n){for(var i=0;i<TIERS.length;i++)if(n>=TIERS[i].min_qty&&n<=TIERS[i].max_qty)return TIERS[i].unit_price;return TIERS.length?TIERS[0].unit_price:25}

/* ---- navegação ---- */
function nav(v){cur=v;document.querySelectorAll('aside a[data-v]').forEach(function(a){a.classList.toggle('on',a.dataset.v===(v==='placa'?'placas':v))});draw()}
function mo(h){$('mb').innerHTML=h;$('mo').style.display='grid'}
function cl(){$('mo').style.display='none';if(pollTimer){clearInterval(pollTimer);pollTimer=null}}
$('mo').onclick=function(e){if(e.target===this)cl()};
function head(t,s){$('hd').innerHTML='<h2>'+t+'</h2><span class="mut">'+s+'</span>'}
function pills(){return '<div class="row">'+[['today','Hoje'],['7','7 dias'],['30','30 dias'],['90','90 dias'],['month','Este mês'],['all','Tudo']].map(function(p){return '<button class="pill '+(per===p[0]?'on':'')+'" onclick="per=\''+p[0]+'\';draw()">'+p[1]+'</button>'}).join('')+'</div>'}
function inP(x){var d=new Date(x.created_at),n=new Date();if(per==='all')return 1;if(per==='today')return d.toDateString()===n.toDateString();if(per==='month')return d.getMonth()===n.getMonth()&&d.getFullYear()===n.getFullYear();return (n-d)/864e5<=+per}
function tot(a){return a.reduce(function(s,x){return s+(x.value!=null?x.value:x.total||0)},0)}
function draw(){$('v').innerHTML=({dash:vDash,placas:vPlacas,placa:vPlaca,vendas:vVendas,comprar:vComprar,pedidos:vPedidos,conta:vConta,academy:vAcad})[cur]()}
function stTag(s){var m={estoque:'Em estoque',ativa:'Ativa',aguardando_pagamento:'Aguardando pagamento',pago:'Pago',enviado:'Enviado',entregue:'Entregue',cancelado:'Cancelado'};return '<span class="st '+(s==='aguardando_pagamento'?'w':s==='estoque'?'g':'')+'">'+(m[s]||s)+'</span>'}

/* ---- dashboard ---- */
function vDash(){head('Dashboard','Veja o desempenho das suas vendas.');
var a=SALES.filter(inP),n=new Date();
var moS=SALES.filter(function(x){var d=new Date(x.created_at);return d.getMonth()===n.getMonth()&&d.getFullYear()===n.getFullYear()}),hj=SALES.filter(function(x){return new Date(x.created_at).toDateString()===n.toDateString()});
var cost=a.reduce(function(s,x){return s+(x.cost||0)},0),est=PLATES.filter(function(p){return p.status==='estoque'}).length,ativ=PLATES.length-est;
var les=lsLes(),done=Object.keys(les).filter(function(k){return les[k]}).length,pc=Math.round(done/LES.length*100);
var b=[],mx=1;for(var i=6;i>=0;i--){var d=new Date();d.setDate(d.getDate()-i);var v=tot(SALES.filter(function(x){return new Date(x.created_at).toDateString()===d.toDateString()}));b.push([d.toLocaleDateString('pt-BR',{weekday:'short'}),v]);mx=Math.max(mx,v)}
return '<div class="card" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap"><div style="flex:1;min-width:200px"><b>🎓 NFC Academy</b><div class="mut" style="margin:4px 0 8px">Próxima aula: '+E(LES[Math.min(done,LES.length-1)])+'</div><div class="pg"><i style="width:'+pc+'%"></i></div></div><b>'+pc+'%</b><button class="btn p" onclick="nav(\'academy\')">Continuar</button></div>'+
'<h3 style="margin:22px 0 0">Vendas</h3>'+pills()+
'<div class="k"><div><small>Faturamento total</small><b>'+R(tot(a))+'</b></div><div><small>Faturamento no mês</small><b>'+R(tot(moS))+'</b></div><div><small>Faturamento hoje</small><b>'+R(tot(hj))+'</b></div><div><small>Ticket médio</small><b>'+R(a.length?tot(a)/a.length:0)+'</b></div><div><small>Lucro estimado</small><b>'+R(tot(a)-cost)+'</b></div><div><small>Placas em estoque</small><b>'+est+'</b></div><div><small>Placas ativas</small><b>'+ativ+'</b></div></div>'+
'<div class="g2"><div class="card"><h3>Últimos 7 dias</h3><div class="bars">'+b.map(function(x){return '<div><small>'+(x[1]?R(x[1]):'')+'</small><i style="height:'+x[1]/mx*100+'%"></i>'+x[0]+'</div>'}).join('')+'</div></div><div class="card"><h3>Vendas recentes</h3>'+(a.length?a.slice(0,5).map(function(x){return '<div class="qty"><span>'+E(x.client_name)+'<br><small class="mut">'+fd(x.created_at)+'</small></span><b>'+R(x.value)+'</b></div>'}).join(''):'<p class="mut">Nenhuma venda no período.</p>')+'</div></div>'}

/* ---- placas ---- */
function vPlacas(){head('Minhas placas','Ative, edite o destino e acompanhe seu estoque.');
return '<div class="grid">'+(PLATES.length?PLATES.map(function(p){return '<div class="pl"><div style="display:flex;justify-content:space-between"><b>#'+pad(p.id)+'</b>'+stTag(p.status)+'</div><div><i class="sw" style="background:'+(p.color==='azul'?'#1d4ed8':'#111')+'"></i>Placa '+p.color+'</div><div>'+(p.client_name?'<b>'+E(p.client_name)+'</b>':'<span class="mut">Sem estabelecimento</span>')+'</div>'+(p.destination_url?'<div class="mut" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">→ '+E(p.destination_url)+'</div>':'')+'<div class="mut">Código: <b>'+p.code+'</b></div><button class="btn s" onclick="edPl('+p.id+')">'+(p.status==='estoque'?'Ativar':'Editar destino')+'</button></div>'}).join(''):'<div class="card">Você ainda não tem placas. <a style="color:var(--pr);cursor:pointer;font-weight:700" onclick="nav(\'comprar\')">Comprar placas</a></div>')+'</div>'}
async function edPl(id){selPl=id;var p=PLATES.filter(function(x){return x.id===id})[0];try{p.reads=await api('/resellers/plates/'+id+'/reads')}catch(e){p.reads=[]}nav('placa')}
function getPl(id){return PLATES.filter(function(x){return x.id===id})[0]}
function qrUrl(p){return PUBLIC_BASE+'/r/'+p.code}
function qrSvg(p){if(!window.qrcode)return '';var q=qrcode(0,'M');q.addData(qrUrl(p));q.make();var n=q.getModuleCount(),m=2,d='';for(var r=0;r<n;r++)for(var c=0;c<n;c++)if(q.isDark(r,c))d+='M'+(c+m)+' '+(r+m)+'h1v1h-1z';var z=n+2*m;return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '+z+' '+z+'" shape-rendering="crispEdges"><rect width="'+z+'" height="'+z+'" fill="#fff"/><path d="'+d+'" fill="#000"/></svg>'}
function vPlaca(){var p=getPl(selPl);if(!p){cur='placas';return vPlacas()}
head('Placa #'+pad(p.id),'<a style="color:var(--pr);cursor:pointer" onclick="nav(\'placas\')">← Voltar para minhas placas</a>');
var rd=(p.reads||[]).map(function(x){return new Date(x.read_at).getTime()}),now=Date.now(),td=new Date().toDateString(),last=rd.length?new Date(Math.max.apply(null,rd)).toLocaleString('pt-BR'):'ainda nenhuma',c=function(f){return rd.filter(f).length},svg=qrSvg(p),
T=['Google Avaliações','Instagram','WhatsApp','Site','Cardápio','Outro'],S=function(l,v){return '<div><small class="mut">'+l+'</small><b style="display:block;font-size:22px">'+v+'</b></div>'};
return '<div class="g2"><div class="card"><small class="mut">SITUAÇÃO: <b style="color:var(--tx)">'+(p.status==='ativa'?'ATIVA':'NÃO CONFIGURADA')+'</b></small><div style="display:grid;gap:12px;margin-top:12px"><label>Nome do cliente / empresa<input id="f1" value="'+E(p.client_name)+'" placeholder="Ex.: Barbearia João"></label><label>Nome / identificação da placa<input id="f2" value="'+E(p.plate_label)+'" placeholder="Ex.: Barbearia João - Balcão"></label><label>Tipo de destino<select id="f3">'+T.map(function(t){return '<option'+(p.destination_type===t?' selected':'')+'>'+t+'</option>'}).join('')+'</select></label><label>Link de destino<input id="f4" value="'+E(p.destination_url)+'" placeholder="https://"></label><div><button class="btn p" onclick="svPl('+p.id+')">Salvar alterações</button></div><small class="mut">A placa continua a mesma. O QR Code e o NFC desta placa não mudam quando você altera o destino.</small></div></div>'+
'<div class="card"><h3>QR Code da placa</h3><div style="text-align:center"><div style="width:220px;margin:auto;background:#fff;border-radius:8px">'+(svg||'<p class="mut" style="padding:20px">QR indisponível.</p>')+'</div><p class="mut" style="font-size:12px">Este QR Code é permanente. O destino pode ser alterado a qualquer momento.</p><div class="row" style="justify-content:center"><a class="btn" target="_blank" rel="noopener" href="'+E(qrUrl(p))+'">Testar link</a></div></div><hr style="border:0;border-top:1px solid var(--br);margin:16px 0"><div class="g2">'+S('Total de leituras',rd.length)+S('Hoje',c(function(t){return new Date(t).toDateString()===td}))+S('7 dias',c(function(t){return now-t<=7*864e5}))+S('30 dias',c(function(t){return now-t<=30*864e5}))+'</div><small class="mut">Última leitura: '+last+'</small></div></div>'}
async function svPl(id){var u=$('f4').value.trim();
try{await api('/resellers/plates/'+id,{method:'PUT',body:JSON.stringify({client_name:$('f1').value.trim(),plate_label:$('f2').value.trim(),destination_type:$('f3').value,destination_url:u})});await loadPlates();draw()}
catch(e){alert(e.message)}}

/* ---- vendas ---- */
function vVendas(){head('Vendas','Registre e acompanhe suas vendas.');var a=SALES.filter(inP);
return '<div class="row"><button class="btn p" onclick="nvSale()">＋ Registrar venda</button></div>'+pills()+'<div class="card"><div class="tw"><table><tr><th>Data</th><th>Cliente</th><th>Placa</th><th>Valor</th><th>Lucro</th><th></th></tr>'+(a.length?a.map(function(x){return '<tr><td>'+fd(x.created_at)+'</td><td>'+E(x.client_name)+'</td><td>'+(x.plate_id?'#'+pad(x.plate_id):'—')+'</td><td>'+R(x.value)+'</td><td>'+R(x.value-(x.cost||0))+'</td><td><button class="btn s" onclick="dlS('+x.id+')">✕</button></td></tr>'}).join(''):'<tr><td colspan="6" class="mut">Nenhuma venda registrada.</td></tr>')+'</table></div></div>'}
function nvSale(){var es=PLATES.filter(function(p){return p.status==='estoque'});mo('<h3 style="margin:0">Registrar venda</h3><label>Cliente / estabelecimento<input id="m1"></label><label>Placa do estoque<select id="m3"><option value="">— sem vincular —</option>'+es.map(function(p){return '<option value="'+p.id+'">#'+pad(p.id)+' · '+p.color+'</option>'}).join('')+'</select></label><label>Valor da venda (R$)<input id="m2" type="number" step="0.01" min="0" value="60"></label><label>Link de avaliação do Google (opcional)<input id="m4" placeholder="https://…"></label><div class="row"><button class="btn p" onclick="svSale()">Salvar</button><button class="btn" onclick="cl()">Cancelar</button></div>')}
async function svSale(){var c=$('m1').value.trim(),v=+$('m2').value,pid=+$('m3').value||null,u=$('m4').value.trim();if(!c||!(v>=0))return alert('Informe cliente e valor.');
try{await api('/resellers/sales',{method:'POST',body:JSON.stringify({client_name:c,value:v,plate_id:pid,destination_url:u})});await Promise.all([loadSales(),loadPlates()]);cl();draw()}catch(e){alert(e.message)}}
async function dlS(id){if(!confirm('Excluir venda?'))return;try{await api('/resellers/sales/'+id,{method:'DELETE'});await loadSales();draw()}catch(e){alert(e.message)}}

/* ---- comprar (checkout real com Mercado Pago) ---- */
function vComprar(){head('Comprar placas','Quanto mais você compra, menor o custo por placa.');var n=N.azul+N.preta,u=n?price(n):0;
return '<div class="g2"><div class="card"><h3>Tabela de preços</h3>'+TIERS.map(function(t){var l=t.max_qty>=1000000?t.min_qty+'+ placas':t.min_qty===t.max_qty?'1 placa':t.min_qty+' a '+t.max_qty+' placas';return '<div class="tier '+(n>=t.min_qty&&n<=t.max_qty?'on':'')+'"><span>'+l+'</span><span>'+R(t.unit_price)+'</span></div>'}).join('')+'<small class="mut">Acrílico 2 mm · 10×10 cm · NFC + QR Code dinâmico · fita dupla face</small></div>'+
'<div class="card"><h3>Seu pedido</h3>'+['azul','preta'].map(function(c){return '<div class="qty"><span><i class="sw" style="background:'+(c==='azul'?'#1d4ed8':'#111')+'"></i>Placa '+c+'</span><span><button onclick="q(\''+c+'\',-1)">−</button> <b style="display:inline-block;min-width:34px;text-align:center">'+N[c]+'</b> <button onclick="q(\''+c+'\',1)">+</button></span></div>'}).join('')+'<div class="qty"><span>Quantidade</span><b>'+n+'</b></div><div class="qty"><span>Por placa</span><b>'+R(u)+'</b></div><div class="qty"><span><b>Total</b></span><b style="font-size:20px">'+R(n*u)+'</b></div><br><button class="btn p" style="width:100%" onclick="openCheckout()">Fazer pedido</button><small class="mut">Pagamento via Pix ou cartão de crédito, processado pelo Mercado Pago.</small></div></div>'}
function q(c,d){N[c]=Math.max(0,N[c]+d);draw()}
function openCheckout(){var n=N.azul+N.preta;if(!n)return alert('Escolha ao menos 1 placa.');var u=price(n),parts=ME.email.split('@'),fname=ME.name.split(' ')[0],lname=ME.name.split(' ').slice(1).join(' ');
mo('<h3 style="margin:0">Finalizar pedido</h3><p class="mut">'+n+' placa(s) · '+R(n*u)+' no total</p><label>Nome<input id="p1" value="'+E(fname)+'"></label><label>Sobrenome<input id="p2" value="'+E(lname)+'"></label><label>E-mail para o pagamento<input id="p3" type="email" value="'+E(ME.email)+'"></label><label>Forma de pagamento<select id="p4"><option value="pix">Pix</option><option value="credit_card">Cartão de crédito</option></select></label><div class="row"><button class="btn p" onclick="doCheckout()">Continuar</button><button class="btn" onclick="cl()">Cancelar</button></div>')}
async function doCheckout(){var body={qty_azul:N.azul,qty_preta:N.preta,method:$('p4').value,payer:{first_name:$('p1').value.trim(),last_name:$('p2').value.trim(),email:$('p3').value.trim()}};
if(!body.payer.first_name||!body.payer.email)return alert('Preencha nome e e-mail.');
mo('<h3 style="margin:0">Processando…</h3><p class="mut">Só um instante, estamos gerando seu pagamento.</p>');
try{
  var r=await api('/payments/checkout',{method:'POST',body:JSON.stringify(body)});
  if(body.method==='pix'){showPix(r)}else{
    mo('<h3 style="margin:0">Pagamento por cartão</h3><p class="mut">Total: '+R(r.total)+'</p><p>Uma nova aba vai abrir para você concluir o pagamento com segurança no Mercado Pago.</p><div class="row"><a class="btn p" href="'+r.checkout_url+'" target="_blank" rel="noopener">Ir para o pagamento</a><button class="btn" onclick="cl()">Fechar</button></div>');
    startPoll(r.order_id);
  }
}catch(e){mo('<h3 style="margin:0">Não foi possível gerar o pagamento</h3><p class="mut">'+E(e.message)+'</p><div class="row"><button class="btn" onclick="cl()">Fechar</button></div>')}}
function showPix(r){
mo('<h3 style="margin:0">Pague com Pix</h3><p class="mut">Total: '+R(r.total)+'</p>'+(r.pix_qr_base64?'<div style="text-align:center"><img src="data:image/png;base64,'+r.pix_qr_base64+'" style="width:220px;height:220px"></div>':'')+'<label>Pix copia e cola<input readonly value="'+E(r.pix_qr_code||'')+'" onclick="this.select()"></label><button class="btn" onclick="navigator.clipboard&&navigator.clipboard.writeText(\''+E(r.pix_qr_code||'').replace(/'/g,"\\'")+'\')">Copiar código</button><p class="mut" id="pxs">Aguardando pagamento…</p><div class="row"><button class="btn" onclick="cl()">Fechar</button></div>');
startPoll(r.order_id);
}
function startPoll(orderId){if(pollTimer)clearInterval(pollTimer);var tries=0;
pollTimer=setInterval(async function(){
  tries++;if(tries>150){clearInterval(pollTimer);pollTimer=null;return} // ~10 min
  try{var o=await api('/payments/orders/'+orderId+'/status');
    if(o.status==='pago'){clearInterval(pollTimer);pollTimer=null;await Promise.all([loadOrders(),loadPlates()]);cl();alert('Pagamento aprovado! Suas placas já estão no estoque.');nav('pedidos')}
    else if(o.status==='cancelado'){clearInterval(pollTimer);pollTimer=null;var s=$('pxs');if(s)s.textContent='Pagamento não aprovado. Tente novamente.'}
  }catch(e){}
},4000)}

/* ---- pedidos ---- */
function vPedidos(){head('Meus pedidos','Acompanhe suas compras de placas.');
return '<div class="card"><div class="tw"><table><tr><th>Pedido</th><th>Data</th><th>Azul</th><th>Preta</th><th>Total</th><th>Pagamento</th><th>Status</th></tr>'+(ORDERS.length?ORDERS.map(function(o){return '<tr><td>#'+String(o.id).padStart(5,'0')+'</td><td>'+fd(o.created_at)+'</td><td>'+o.qty_azul+'</td><td>'+o.qty_preta+'</td><td>'+R(o.total)+'</td><td>'+(o.payment_method==='pix'?'Pix':o.payment_method==='credit_card'?'Cartão':'—')+'</td><td>'+stTag(o.status)+'</td></tr>'}).join(''):'<tr><td colspan="7" class="mut">Nenhum pedido ainda.</td></tr>')+'</table></div></div>'}

/* ---- conta / academy ---- */
function vConta(){head('Minha conta','Seus dados de revendedor.');
return '<div class="card" style="max-width:460px;display:grid;gap:10px"><label>Nome<input id="c1" value="'+E(ME.name)+'"></label><label>E-mail<input value="'+E(ME.email)+'" disabled></label><label>WhatsApp<input id="c2" value="'+E(ME.whatsapp)+'"></label><div class="row"><button class="btn p" onclick="svC()">Salvar</button><button class="btn" onclick="out()">Sair</button></div></div>'}
async function svC(){try{await api('/resellers/me',{method:'PUT',body:JSON.stringify({name:$('c1').value.trim(),whatsapp:$('c2').value.trim()})});ME=await api('/resellers/me');$('un').textContent=ME.name;$('av').textContent=ME.name.charAt(0).toUpperCase();alert('Salvo!')}catch(e){alert(e.message)}}
function vAcad(){head('NFC Academy','Aprenda a configurar, apresentar e vender suas placas.');var les=lsLes(),done=Object.keys(les).filter(function(k){return les[k]}).length;
return '<div class="card"><div class="pg"><i style="width:'+Math.round(done/LES.length*100)+'%"></i></div><small class="mut">'+done+' de '+LES.length+' aulas concluídas</small>'+LES.map(function(l,i){return '<div class="qty"><span><b>'+(i+1)+'.</b> '+E(l)+'</span><button class="btn s" onclick="ls('+i+')" style="width:auto;height:auto">'+(les[i]?'✔ Concluída':'Marcar como concluída')+'</button></div>'}).join('')+'</div>'}
function ls(i){var les=lsLes();les[i]=!les[i];svLes(les);draw()}

/* ---- boot ---- */
var initialTab=new URLSearchParams(location.search).get('tab');
at(initialTab==='login'?'e':'c');
(function(){var t=null;try{t=localStorage.getItem('nx_token')}catch(e){}
if(t){TOKEN=t;boot().catch(function(){out()})}})();
</script></body></html>
<!DOCTYPE html>
<html lang="pt-BR"><head>
<meta name="robots" content="noindex,nofollow"><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>NexTap — Painel Admin</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f0f5f1;--card:#fff;--tx:#0f1a13;--mut:#5b6b60;--br:#dfe8e2;--pr:#15803d;--pr2:#0f6a31;--soft:#e4f0e8;--dk:#111827}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1410;--card:#16211b;--tx:#eaf3ed;--mut:#9bb0a3;--br:#243329;--soft:#1b2a21}}
:root[data-theme="dark"]{--bg:#0d1410;--card:#16211b;--tx:#eaf3ed;--mut:#9bb0a3;--br:#243329;--soft:#1b2a21}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;line-height:1.45}
.logo{font-weight:800;font-size:21px;display:flex;align-items:center;gap:8px}.logo i{width:30px;height:30px;border-radius:8px;background:var(--dk);display:grid;place-items:center;color:#fff;font-style:normal}
.btn{display:inline-block;border:1px solid var(--br);background:var(--card);color:var(--tx);padding:9px 16px;border-radius:10px;font:600 14px inherit;cursor:pointer}.btn.p{background:var(--dk);border-color:var(--dk);color:#fff}.btn.p:hover{opacity:.9}.btn.s{padding:5px 10px;font-size:12px}.btn.d{border-color:#dc2626;color:#dc2626}
input,select{padding:10px;border:1px solid var(--br);border-radius:10px;background:var(--card);color:var(--tx);font:inherit;width:100%;min-width:0}
label{display:grid;gap:4px;font-size:12px;color:var(--mut)}.mut{color:var(--mut)}
#auth{min-height:100vh;display:grid;place-items:center;padding:20px}#auth .box{width:100%;max-width:380px;background:var(--card);border:1px solid var(--br);border-radius:18px;padding:28px;display:grid;gap:12px}
#app{display:none;grid-template-columns:240px 1fr;min-height:100vh}
aside{background:var(--dk);color:#cbd5c9;border-right:1px solid var(--br);padding:18px;display:flex;flex-direction:column;gap:2px;position:sticky;top:0;height:100vh}
aside small{color:#7d8c86;font-size:11px;letter-spacing:.06em;margin:14px 10px 4px}aside a{padding:10px 12px;border-radius:10px;font-size:14px;cursor:pointer;color:#e5efe8}aside a.on{background:#1f2a24;color:#fff;font-weight:700}
.me{margin-top:auto;display:flex;gap:10px;align-items:center;padding:10px;border:1px solid #2a362f;border-radius:12px;font-size:13px}.av{width:34px;height:34px;border-radius:50%;background:var(--pr);color:#fff;display:grid;place-items:center;font-weight:700}
main{padding:24px;min-width:0}.top{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:8px;flex-wrap:wrap}h2{margin:0}
.card{background:var(--card);border:1px solid var(--br);border-radius:14px;padding:18px;margin-top:14px}.card h3{margin:0 0 10px;font-size:16px}
.k{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-top:14px}.k div{background:var(--card);border:1px solid var(--br);border-radius:14px;padding:16px}.k small{color:var(--mut)}.k b{display:block;font-size:22px;margin-top:4px}.k div:first-child{background:var(--dk);color:#fff;border-color:var(--dk)}.k div:first-child small{color:#c9d3cd}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;align-items:center}.pill{padding:7px 13px;border-radius:99px;border:1px solid var(--br);background:var(--card);color:var(--tx);cursor:pointer;font-size:13px}.pill.on{background:var(--dk);color:#fff;border-color:var(--dk)}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--br);white-space:nowrap}th{color:var(--mut);font-weight:600}
.st{padding:3px 10px;border-radius:99px;font-size:12px;font-weight:700}.st.pendente{background:#fef3c7;color:#92400e}.st.enviado{background:#dbeafe;color:#1e40af}.st.entregue{background:#dcfce7;color:#166534}.st.g{background:#e5e7eb;color:#374151}.st.ativa{background:#dcfce7;color:#166534}
.bars{display:flex;align-items:flex-end;gap:10px;height:150px}.bars div{flex:1;text-align:center;font-size:11px;color:var(--mut);display:flex;flex-direction:column;justify-content:flex-end;height:100%}.bars i{background:var(--dk);border-radius:6px 6px 0 0;display:block;min-height:2px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.tier{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:9px 12px;border:1px solid var(--br);border-radius:10px;margin-bottom:6px}
#mo{display:none;position:fixed;inset:0;background:#0007;z-index:20;place-items:center;padding:16px}#mo .box{background:var(--card);border-radius:16px;padding:22px;width:100%;max-width:420px;display:grid;gap:10px;max-height:90vh;overflow:auto}
.bar{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--br)}
@media(max-width:800px){#app{grid-template-columns:1fr}aside{position:static;height:auto;flex-direction:row;overflow-x:auto;align-items:center}aside small,.me{display:none}aside a{white-space:nowrap}.g2,.g3{grid-template-columns:1fr}}
</style></head><body>

<div id="auth"><div class="box">
<div class="logo" style="justify-content:center"><img src="data:image/png;base64," alt="NexTap" style="height:44px;width:auto"></div>
<div class="mut" style="text-align:center;font-size:13px;margin-top:-6px">Painel do fornecedor</div>
<label>E-mail<input id="ae" type="email" value="admin@nextap.com.br"></label>
<label>Senha de administrador<input id="ap" type="password" placeholder="Senha do fornecedor"></label>
<button class="btn p" onclick="sub()">Entrar</button>
<small class="mut">Acesso restrito ao fornecedor. Use o e-mail e a senha definidos em ADMIN_EMAIL / ADMIN_PASSWORD no backend.</small></div></div>

<div id="app">
<aside><div class="logo" style="padding:4px 8px 8px"><i>⚙</i>NexTap</div>
<small>PAINEL</small><a data-v="dash" onclick="nav('dash')">▦ Visão geral</a><a data-v="revs" onclick="nav('revs')">👥 Revendedores</a><a data-v="pedidos" onclick="nav('pedidos')">📦 Pedidos</a><a data-v="placas" onclick="nav('placas')">▣ Placas emitidas</a>
<small>GESTÃO</small><a data-v="fin" onclick="nav('fin')">💰 Financeiro</a><a data-v="cfg" onclick="nav('cfg')">⚙ Preços</a>
<div class="me"><div class="av">A</div><div><b>Admin</b><div class="mut" style="color:#7d8c86">Fornecedor</div></div><button class="btn s" style="margin-left:auto" onclick="out()" title="Sair">⎋</button></div></aside>
<main><div class="top"><div id="hd"></div><button class="btn" onclick="theme()">◐</button></div><div id="v"></div></main></div>
<div id="mo"><div class="box" id="mb"></div></div>

<script>
/* ==== CONFIGURAÇÃO ==== */
// Troque pela URL pública do seu backend depois do deploy (Railway/Render), terminando em /api
// Mesmo domínio do backend: as páginas são servidas pelo próprio Railway, então a API fica em /api
// (sem CORS). Se abrir o arquivo direto do computador, cai no endereço público do backend.
const API_BASE = (location.protocol.indexOf("http") === 0 ? location.origin : "https://nextap-production-6c30.up.railway.app") + "/api";
/* ======================= */

var $=function(i){return document.getElementById(i)},per='all',cur='dash',TOKEN=null;
var OVER={},REVS=[],ORDERS=[],PLATES=[],TIERS=[];
function R(n){return (n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}
function E(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function fd(d){return new Date(d).toLocaleDateString('pt-BR')}
function theme(){var r=document.documentElement,d=r.dataset.theme==='dark'||(!r.dataset.theme&&matchMedia('(prefers-color-scheme:dark)').matches);r.dataset.theme=d?'light':'dark'}

async function api(path,opts){
  opts=opts||{};var h=opts.headers||{};h['Content-Type']='application/json';if(TOKEN)h['Authorization']='Bearer '+TOKEN;
  var r;try{r=await fetch(API_BASE+path,Object.assign({},opts,{headers:h}))}
  catch(e){throw new Error('Não foi possível conectar ao servidor.')}
  var data=null;try{data=await r.json()}catch(e){}
  if(!r.ok)throw new Error((data&&data.error)||'Ocorreu um erro inesperado.');
  return data;
}
async function sub(){var email=$('ae').value.trim(),pass=$('ap').value;
try{var r=await api('/auth/admin-login',{method:'POST',body:JSON.stringify({email:email,password:pass})});TOKEN=r.token;try{localStorage.setItem('nx_admin_token',TOKEN)}catch(e){}await boot()}
catch(e){alert(e.message)}}
function out(){TOKEN=null;try{localStorage.removeItem('nx_admin_token')}catch(e){}$('app').style.display='none';$('auth').style.display='grid'}
async function boot(){await loadAll();$('auth').style.display='none';$('app').style.display='grid';nav('dash')}
async function loadAll(){var r=await Promise.all([api('/admin/overview'),api('/admin/resellers'),api('/admin/orders'),api('/admin/plates'),api('/admin/price-tiers')]);
OVER=r[0];REVS=r[1];ORDERS=r[2];PLATES=r[3];TIERS=r[4]}

function inP(x){var d=new Date(x.created_at),n=new Date();if(per==='all')return 1;if(per==='today')return d.toDateString()===n.toDateString();if(per==='month')return d.getMonth()===n.getMonth()&&d.getFullYear()===n.getFullYear();return (n-d)/864e5<=+per}
function pills(){return '<div class="row">'+[['today','Hoje'],['7','7 dias'],['30','30 dias'],['90','90 dias'],['month','Este mês'],['all','Tudo']].map(function(p){return '<button class="pill '+(per===p[0]?'on':'')+'" onclick="per=\''+p[0]+'\';draw()">'+p[1]+'</button>'}).join('')+'</div>'}
function head(t,s){$('hd').innerHTML='<h2>'+t+'</h2><span class="mut">'+s+'</span>'}
function nav(v){cur=v;document.querySelectorAll('aside a[data-v]').forEach(function(a){a.classList.toggle('on',a.dataset.v===v)});draw()}
function mo(h){$('mb').innerHTML=h;$('mo').style.display='grid'}function cl(){$('mo').style.display='none'}
$('mo').onclick=function(e){if(e.target===this)cl()};
function draw(){$('v').innerHTML=({dash:vDash,revs:vRevs,pedidos:vPedidos,placas:vPlacas,fin:vFin,cfg:vCfg})[cur]()}
var STM={aguardando_pagamento:'Aguardando pagamento',pago:'Pago',enviado:'Enviado',entregue:'Entregue',cancelado:'Cancelado',estoque:'Em estoque',ativa:'Ativa'};
function stTag(s){return '<span class="st '+(s||'').toLowerCase()+'">'+(STM[s]||s)+'</span>'}

/* dash */
function vDash(){head('Visão geral','Desempenho de todos os revendedores.');var os=ORDERS.filter(inP);
var b=[],mx=1;for(var i=6;i>=0;i--){var d=new Date();d.setDate(d.getDate()-i);var v=os.filter(function(o){return new Date(o.created_at).toDateString()===d.toDateString()}).reduce(function(s,o){return s+o.total},0);b.push([d.toLocaleDateString('pt-BR',{weekday:'short'}),v]);mx=Math.max(mx,v)}
return pills()+'<div class="k"><div><small>Faturamento (pedidos pagos)</small><b>'+R(OVER.faturamento)+'</b></div><div><small>Revendedores cadastrados</small><b>'+OVER.revendedores+'</b></div><div><small>Pedidos aguardando pagamento</small><b>'+OVER.pendentes+'</b></div><div><small>Placas emitidas</small><b>'+OVER.placas+'</b></div><div><small>Placas ativas</small><b>'+OVER.ativas+'</b></div></div>'+
'<div class="g2"><div class="card"><h3>Pedidos (7 dias)</h3><div class="bars">'+b.map(function(x){return '<div><small>'+(x[1]?R(x[1]):'')+'</small><i style="height:'+x[1]/mx*100+'%"></i>'+x[0]+'</div>'}).join('')+'</div></div>'+

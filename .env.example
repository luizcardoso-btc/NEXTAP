# Copie este arquivo para ".env" e preencha com seus dados reais.

# Porta em que o servidor vai rodar
PORT=3000

# Chave usada para assinar os tokens de login (JWT). Troque por um valor aleatório e secreto.
JWT_SECRET=troque-por-uma-string-aleatoria-bem-grande

# Access Token do Mercado Pago (Produção). Pegue em:
# https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública do backend depois de publicado (ex: Railway, Render).
# É para onde o Mercado Pago vai enviar as notificações de pagamento (webhook).
PUBLIC_BACKEND_URL=https://seu-backend.exemplo.com

# URL pública do site/painel do revendedor, para redirecionar após o pagamento
FRONTEND_URL=https://seusite.exemplo.com

# Senha do painel de administrador (fornecedor)
ADMIN_EMAIL=admin@nextap.com.br
ADMIN_PASSWORD=troque-esta-senha
